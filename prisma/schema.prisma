datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String?
  image         String?
  role          String    @default("USER") // USER, ADMIN
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  submissions       Submission[]
  contestAttempts   ContestAttempt[]
  interviewSessions InterviewSession[]
  userProgress      UserProgress[]
  savedDrafts       CodeDraft[]

  @@index([email])
  @@index([role])
}

model Problem {
  id            String   @id @default(cuid())
  slug          String   @unique
  title         String
  statement     String
  inputFormat   String
  outputFormat  String
  constraints   String
  difficulty    String   @default("MEDIUM") // EASY, MEDIUM, HARD
  timeLimitMs   Int      @default(1000)
  memoryLimitKb Int      @default(262144)
  editorial     String?
  isPublished   Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  testCases       TestCase[]
  submissions     Submission[]
  contestProblems ContestProblem[]
  userProgress    UserProgress[]
  problemTags     ProblemTag[]
  savedDrafts     CodeDraft[]

  @@index([slug])
  @@index([difficulty])
  @@index([isPublished])
  @@index([createdAt])
}

model TestCase {
  id             String   @id @default(cuid())
  problemId      String
  input          String
  expectedOutput String
  isSample       Boolean  @default(false)
  explanation    String?
  orderIndex     Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  problem               Problem                @relation(fields: [problemId], references: [id], onDelete: Cascade)
  submissionCaseResults SubmissionCaseResult[]

  @@index([problemId])
  @@index([problemId, isSample])
  @@index([orderIndex])
}

model Tag {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now())

  problemTags ProblemTag[]

  @@index([slug])
}

model ProblemTag {
  id        String @id @default(cuid())
  problemId String
  tagId     String

  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([problemId, tagId])
  @@index([tagId, problemId])
  @@index([problemId])
}

model CodeDraft {
  id        String   @id @default(cuid())
  userId    String
  problemId String
  language  String   // C, CPP, JAVA, PYTHON
  code      String
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([userId, problemId, language])
  @@index([userId, problemId])
}

model Submission {
  id               String   @id @default(cuid())
  userId           String
  problemId        String
  contestAttemptId String?
  language         String   // C, CPP, JAVA, PYTHON
  code             String
  verdict          String   @default("PENDING") // ACCEPTED, WRONG_ANSWER, TIME_LIMIT_EXCEEDED, MEMORY_LIMIT_EXCEEDED, RUNTIME_ERROR, COMPILATION_ERROR, PENDING, RUNNING
  executionTimeMs  Int?
  memoryKb         Int?
  compileOutput    String?
  errorOutput      String?
  totalCases       Int      @default(0)
  passedCases      Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem        Problem                @relation(fields: [problemId], references: [id], onDelete: Cascade)
  contestAttempt ContestAttempt?        @relation(fields: [contestAttemptId], references: [id], onDelete: SetNull)
  caseResults    SubmissionCaseResult[]

  @@index([userId, problemId])
  @@index([userId, createdAt])
  @@index([problemId, verdict])
  @@index([contestAttemptId])
  @@index([createdAt])
}

model SubmissionCaseResult {
  id              String   @id @default(cuid())
  submissionId    String
  testCaseId      String
  verdict         String
  executionTimeMs Int?
  memoryKb        Int?
  stdout          String?
  stderr          String?
  isSample        Boolean  @default(false)
  createdAt       DateTime @default(now())

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  testCase   TestCase   @relation(fields: [testCaseId], references: [id], onDelete: Cascade)

  @@index([submissionId])
  @@index([testCaseId])
}

model UserProgress {
  id              String    @id @default(cuid())
  userId          String
  problemId       String
  solved          Boolean   @default(false)
  attempted       Boolean   @default(true)
  solvedAt        DateTime?
  lastAttemptedAt DateTime  @default(now())
  submissionCount Int       @default(1)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([userId, problemId])
  @@index([userId, solved])
  @@index([problemId])
}

model Contest {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  description     String
  durationMinutes Int      @default(90)
  presetType      String   @default("STANDARD_90") // STANDARD_90, STANDARD_180, CUSTOM
  isPublished     Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  contestProblems ContestProblem[]
  attempts        ContestAttempt[]

  @@index([slug])
  @@index([presetType])
}

model ContestProblem {
  id         String @id @default(cuid())
  contestId  String
  problemId  String
  points     Int    @default(100)
  orderIndex Int    @default(0)

  contest Contest @relation(fields: [contestId], references: [id], onDelete: Cascade)
  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([contestId, problemId])
  @@index([contestId, orderIndex])
  @@index([problemId])
}

model ContestAttempt {
  id                String    @id @default(cuid())
  contestId         String
  userId            String
  startedAt         DateTime  @default(now())
  endsAt            DateTime
  submittedAt       DateTime?
  score             Int       @default(0)
  totalTimeSpentSec Int       @default(0)
  status            String    @default("IN_PROGRESS") // IN_PROGRESS, COMPLETED, TIMED_OUT
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  contest     Contest      @relation(fields: [contestId], references: [id], onDelete: Cascade)
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  submissions Submission[]

  @@index([userId, contestId])
  @@index([status])
  @@index([endsAt])
}

model InterviewSession {
  id          String    @id @default(cuid())
  userId      String
  type        String    @default("TECHNICAL") // TECHNICAL, MANAGERIAL_HR
  language    String?   // C, CPP, JAVA, PYTHON
  problemId   String?
  status      String    @default("IN_PROGRESS") // IN_PROGRESS, COMPLETED, ABANDONED
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  InterviewMessage[]
  scorecard InterviewScorecard?

  @@index([userId, createdAt])
  @@index([status])
}

model InterviewMessage {
  id         String   @id @default(cuid())
  sessionId  String
  role       String   // SYSTEM, ASSISTANT, USER
  content    String
  orderIndex Int      @default(0)
  createdAt  DateTime @default(now())

  session InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, orderIndex])
}

model InterviewScorecard {
  id                  String   @id @default(cuid())
  sessionId           String   @unique
  overallScore        Float
  communicationScore  Float
  correctnessScore    Float
  problemSolvingScore Float
  confidenceScore     Float
  strengths           String
  gaps                String
  sevenDayPlan        String
  transcriptSummary   String
  isStaticFallback    Boolean  @default(false)
  createdAt           DateTime @default(now())

  session InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}
