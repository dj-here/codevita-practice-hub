  "statement": "A balance scale requires two distinct weight blocks from an inventory of N blocks such that their combined weight is exactly Target.\n\nGiven an array of N integers and a target value Target, determine whether there exist two distinct indices i != j such that A[i] + A[j] = Target. Print \"YES\" if such a pair exists, or \"NO\" otherwise.",
  "inputFormat": "First line: Two integers N and Target.\nSecond line: N space-separated integers.",
  "outputFormat": "Print \"YES\" or \"NO\".",
  "constraints": "2 <= N <= 10^5, -10^9 <= A[i], Target <= 10^9",
  "sampleCases": [
    {
      "input": "5 9\n2 7 11 15 3",
      "expectedOutput": "YES",
      "explanation": "2 + 7 = 9."
    },
    {
      "input": "4 10\n1 2 3 4",
      "expectedOutput": "NO",
      "explanation": "No two numbers sum to 10."
    }
  ],
  "hiddenCases": [
