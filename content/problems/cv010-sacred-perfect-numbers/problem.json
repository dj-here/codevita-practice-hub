  "statement": "A number N is called \"Perfect\" if the sum of all its proper positive divisors (divisors strictly less than N) is equal to N itself. For example, 6 has proper divisors 1, 2, 3, and 1 + 2 + 3 = 6.\n\nGiven an integer N, print \"PERFECT\" if N is a perfect number, or \"NOT PERFECT\" otherwise.",
  "inputFormat": "A single integer N.",
  "outputFormat": "Print \"PERFECT\" or \"NOT PERFECT\".",
  "constraints": "1 <= N <= 10^9",
  "sampleCases": [
    {
      "input": "6",
      "expectedOutput": "PERFECT",
      "explanation": "Proper divisors: 1, 2, 3. Sum = 6."
    },
    {
      "input": "28",
      "expectedOutput": "PERFECT",
      "explanation": "Proper divisors: 1, 2, 4, 7, 14. Sum = 28."
    },
    {
      "input": "12",
      "expectedOutput": "NOT PERFECT",
      "explanation": "Proper divisors: 1, 2, 3, 4, 6. Sum = 16 != 12."
    }
  ],
  "hiddenCases": [
    {
      "input": "1",
      "expectedOutput": "NOT PERFECT"
    },
    {
      "input": "496",
      "expectedOutput": "PERFECT"
    },
    {
      "input": "8128",
      "expectedOutput": "PERFECT"
    },
    {
      "input": "33550336",
      "expectedOutput": "PERFECT"
    },
    {
      "input": "100",
      "expectedOutput": "NOT PERFECT"
    },
    {
      "input": "9999999",
      "expectedOutput": "NOT PERFECT"
    },
