  "statement": "Given a string S, transform every letter individually to be lowercase or uppercase to create another string.\nDigits remain unchanged.\n\nReturn all possible case permutations sorted in lexicographical order, each on a new line.",
  "inputFormat": "A single string S.",
  "outputFormat": "Print each permutation on a new line in sorted order.",
  "constraints": "1 <= len(S) <= 12",
  "sampleCases": [
    {
      "input": "a1b2",
      "expectedOutput": "A1B2\nA1b2\na1B2\na1b2",
      "explanation": "All 4 permutations in sorted order."
    },
    {
      "input": "3z4",
      "expectedOutput": "3Z4\n3z4",
      "explanation": "Two permutations."
    }
  ],
  "hiddenCases": [
    {
      "input": "123",
      "expectedOutput": "123"
    },
    {
      "input": "a",
      "expectedOutput": "A\na"
    },
    {
      "input": "ab",
      "expectedOutput": "AB\nAb\naB\nab"
    },
    {
      "input": "C",
      "expectedOutput": "C\nc"
    },
    {
      "input": "0a1b",
      "expectedOutput": "0A1B\n0A1b\n0a1B\n0a1b"
    },
    {
      "input": "abc",
      "expectedOutput": "ABC\nABc\nAbC\nAbc\naBC\naBc\nabC\nabc"
    },
    {
      "input": "1a2b3c",
      "expectedOutput": "1A2B3C\n1A2B3c\n1A2b3C\n1A2b3c\n1a2B3C\n1a2B3c\n1a2b3C\n1a2b3c"
    },
    {
      "input": "xyz",
