      "explanation": "Remove [1, 3] to make the rest non-overlapping."
    },
    {
      "input": "3\n1 2\n1 2\n1 2",
      "expectedOutput": "2",
      "explanation": "Remove 2 duplicate intervals."
    }
  ],
  "hiddenCases": [
    {
      "input": "1\n1 2",
      "expectedOutput": "0"
