  "statement": "Two ancient stone cylinders are engraved with strings S1 and S2. A cylinder can be rotated clockwise by any number of positions.\n\nDetermine whether S2 is a rotation of S1. Print \"YES\" if S2 can be formed by rotating S1, or \"NO\" otherwise.",
  "inputFormat": "Two space-separated strings S1 and S2.",
  "outputFormat": "Print \"YES\" or \"NO\".",
  "constraints": "1 <= |S1|, |S2| <= 10^5",
  "sampleCases": [
    {
      "input": "abcde cdeab",
      "expectedOutput": "YES",
      "explanation": "\"abcde\" shifted by 2 becomes \"cdeab\"."
    },
    {
      "input": "abcde abced",
      "expectedOutput": "NO",
      "explanation": "Different letter order."
    }
  ],
  "hiddenCases": [
    {
      "input": "a a",
      "expectedOutput": "YES"
    },
    {
      "input": "ab ba",
      "expectedOutput": "YES"
    },
    {
      "input": "waterbottle erbottlewat",
      "expectedOutput": "YES"
    },
    {
      "input": "hello world",
      "expectedOutput": "NO"
    },
    {
      "input": "rotate tatero",
      "expectedOutput": "YES"
    },
    {
      "input": "abc def",
      "expectedOutput": "NO"
    },
    {
      "input": "aaaa bbbb",
      "expectedOutput": "NO"
    },
    {
      "input": "tcsion iontcs",
      "expectedOutput": "YES"
    }
  ]
