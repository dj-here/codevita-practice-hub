      "expectedOutput": "NO",
      "explanation": "No subset sums to 9."
    },
    {
      "input": "5 10\n1 2 7 4 5",
      "expectedOutput": "YES",
      "explanation": "Subset [1, 2, 7] or [1, 4, 5] sums to 10."
    }
  ],
  "hiddenCases": [
