{
  "id": "cv025",
  "slug": "cv025-run-length-compression",
  "title": "The Telegraph Run-Length Encoding",
  "difficulty": "EASY",
  "topics": [
    "Strings & Parsing"
  ],
  "timeLimitMs": 1000,
  "memoryLimitKb": 262144,
  "statement": "A telegraph operator transmits character streams. To reduce bandwidth, runs of identical consecutive characters are compressed into the character followed by the run length count. For example, \"aaabbc\" is compressed to \"a3b2c1\".\n\nGiven a string S, output its compressed run-length representation.",
  "inputFormat": "A single string S.",
  "outputFormat": "Print the compressed string.",
  "constraints": "1 <= |S| <= 10^5, alphanumeric characters.",
  "sampleCases": [
    {
      "input": "aaabbc",
      "expectedOutput": "a3b2c1",
      "explanation": "3 a's, 2 b's, 1 c."
    },
    {
      "input": "a",
      "expectedOutput": "a1",
      "explanation": "Single character run."
    }
  ],
  "hiddenCases": [
    {
      "input": "abcdef",
      "expectedOutput": "a1b1c1d1e1f1"
    },
    {
      "input": "aaaaa",
      "expectedOutput": "a5"
    },
    {
      "input": "aabbccddeeff",
      "expectedOutput": "a2b2c2d2e2f2"
    },
    {
      "input": "zzzzzZZZZZ",
      "expectedOutput": "z5Z5"
    },
    {
      "input": "1112233334",
      "expectedOutput": "13223441"
    },
    {
      "input": "abba",
      "expectedOutput": "a1b2a1"
    },
    {
      "input": "wwwwwwwwwwwwwwww",
      "expectedOutput": "w16"
    },
    {
      "input": "abcba",
      "expectedOutput": "a1b1c1b1a1"
    }
  ]
}