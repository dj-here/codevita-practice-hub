  "statement": "Given an integer N, determine whether it is a power of two.\nAn integer N is a power of two if there exists an integer x such that N == 2^x.\n\nPrint YES if N is a power of two, otherwise print NO.",
  "inputFormat": "A single integer N.",
  "outputFormat": "Print YES or NO.",
  "constraints": "-2^62 <= N <= 2^62",
  "sampleCases": [
    {
      "input": "1",
      "expectedOutput": "YES",
      "explanation": "2^0 = 1."
    },
    {
      "input": "16",
      "expectedOutput": "YES",
      "explanation": "2^4 = 16."
    }
  ],
  "hiddenCases": [
    {
      "input": "3",
      "expectedOutput": "NO"
    },
    {
      "input": "0",
      "expectedOutput": "NO"
    },
    {
      "input": "-16",
      "expectedOutput": "NO"
    },
    {
      "input": "1024",
      "expectedOutput": "YES"
    },
    {
      "input": "1048576",
      "expectedOutput": "YES"
    },
    {
      "input": "1000000000",
      "expectedOutput": "NO"
    },
    {
      "input": "1152921504606846976",
      "expectedOutput": "YES"
    },
    {
      "input": "-1",
      "expectedOutput": "NO"
    }
  ]
}