  "outputFormat": "Print their product string.",
  "constraints": "1 <= |Num1|, |Num2| <= 500",
  "sampleCases": [
    {
      "input": "2 3",
      "expectedOutput": "6",
      "explanation": "2 * 3 = 6."
    },
