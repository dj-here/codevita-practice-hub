{
  "id": "cv121",
  "slug": "cv121-coprime-pairs-in-range",
  "title": "The Mutual Coprimality Pair Counter",
  "difficulty": "MEDIUM",
  "topics": [
    "Number Theory & Primes"
  ],
  "timeLimitMs": 1500,
  "memoryLimitKb": 262144,
  "statement": "Given an array of N integers, count the number of unordered pairs of indices (i, j) with 0 <= i < j < N such that gcd(A_i, A_j) == 1 (the elements are coprime).",
  "inputFormat": "First line: Integer N.\nSecond line: N space-separated integers.",
  "outputFormat": "Print the count of coprime pairs.",
  "constraints": "2 <= N <= 2000\n1 <= A_i <= 10000",
  "sampleCases": [
    {
      "input": "3\n2 3 4",
      "expectedOutput": "2",
      "explanation": "Pairs: (2, 3) -> gcd=1, (3, 4) -> gcd=1. (2, 4) has gcd=2. Total 2."
    },
    {
      "input": "4\n1 2 3 4",
      "expectedOutput": "5",
      "explanation": "(1,2), (1,3), (1,4), (2,3), (3,4) are coprime (5 pairs)."
    }
  ],
  "hiddenCases": [
    {
      "input": "2\n4 6",
      "expectedOutput": "0"
    },
    {
      "input": "2\n7 11",
      "expectedOutput": "1"
    },
    {
      "input": "5\n2 4 6 8 10",
      "expectedOutput": "0"
    },
    {
      "input": "5\n3 5 7 11 13",
      "expectedOutput": "10"
    },
    {
      "input": "6\n1 1 1 1 1 1",
      "expectedOutput": "15"
    },
    {
      "input": "6\n10 15 21 25 35 49",
      "expectedOutput": "5"
    },
    {
      "input": "7\n12 18 24 30 36 42 48",
      "expectedOutput": "0"
    },
    {
      "input": "5\n100 200 300 400 500",
      "expectedOutput": "0"
    }
  ]
}