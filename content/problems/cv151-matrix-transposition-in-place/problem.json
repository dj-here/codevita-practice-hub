      "expectedOutput": "1 4\n2 5\n3 6",
      "explanation": "2x3 matrix transposed to 3x2."
    },
    {
      "input": "1 2\n10 20",
      "expectedOutput": "10\n20",
      "explanation": "1x2 to 2x1."
    }
  ],
  "hiddenCases": [
    {
      "input": "1 1\n42",
      "expectedOutput": "42"
