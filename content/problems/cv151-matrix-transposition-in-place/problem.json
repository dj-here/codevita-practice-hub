      "expectedOutput": "1 4 7\n2 5 8\n3 6 9"
    },
    {
      "input": "2 4\n5 10 15 20\n25 30 35 40",
      "expectedOutput": "5 25\n10 30\n15 35\n20 40"
    },
    {
      "input": "4 2\n1 2\n3 4\n5 6\n7 8",
