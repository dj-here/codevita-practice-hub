{
  "id": "cv160",
  "slug": "cv160-restore-valid-ip-addresses",
  "title": "The Legacy Packet IP Address Restorer",
  "difficulty": "MEDIUM",
  "topics": [
    "Recursion & Backtracking"
  ],
  "timeLimitMs": 1000,
  "memoryLimitKb": 262144,
  "statement": "Given a string S containing only digits, restore all possible valid IPv4 address combinations.\nA valid IPv4 address consists of exactly 4 integers separated by single dots, each integer between 0 and 255 with no leading zeros (e.g. \"0.1.2.201\" is valid, but \"0.01.2.201\" and \"256.1.1.1\" are invalid).\n\nPrint all valid restored IP addresses in lexicographical order, each on a new line. If no valid address exists, print NONE.",
  "inputFormat": "A single string S.",
  "outputFormat": "Print each valid IP address on a new line, or NONE.",
  "constraints": "1 <= len(S) <= 20",
  "sampleCases": [
    {
      "input": "25525511135",
      "expectedOutput": "255.255.11.135\n255.255.111.35",
      "explanation": "Two valid IP configurations."
    },
    {
      "input": "0000",
      "expectedOutput": "0.0.0.0",
      "explanation": "Single valid zero configuration."
    }
  ],
  "hiddenCases": [
    {
      "input": "101023",
      "expectedOutput": "1.0.10.23\n1.0.102.3\n10.1.0.23\n10.10.2.3\n101.0.2.3"
    },
    {
      "input": "1111",
      "expectedOutput": "1.1.1.1"
    },
    {
      "input": "010010",
      "expectedOutput": "0.10.0.10\n0.100.1.0"
    },
    {
      "input": "256256256256",
      "expectedOutput": "NONE"
    },
    {
      "input": "19216811",
      "expectedOutput": "1.92.168.11\n19.2.168.11\n19.21.68.11\n19.216.8.11\n19.216.81.1\n192.1.68.11\n192.16.8.11\n192.16.81.1\n192.168.1.1"
    },
    {
      "input": "123",
      "expectedOutput": "NONE"
    },
    {
      "input": "1234567890123",
      "expectedOutput": "NONE"
    },
    {
      "input": "172162541",
      "expectedOutput": "17.216.25.41\n17.216.254.1\n172.16.25.41\n172.16.254.1\n172.162.5.41\n172.162.54.1"
    }
  ]
}