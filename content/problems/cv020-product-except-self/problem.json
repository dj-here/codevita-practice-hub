{
  "id": "cv020",
  "slug": "cv020-product-except-self",
  "title": "The Harmonic Array Multiplication",
  "difficulty": "EASY",
  "topics": [
    "Arrays & Two Pointers"
  ],
  "timeLimitMs": 1000,
  "memoryLimitKb": 262144,
  "statement": "Given an integer array A of size N, return an array Output such that Output[i] is equal to the product of all elements of A except A[i], modulo 1000000007.\n\nYou must not use division, as modular division by zero is undefined.",
  "inputFormat": "First line: Integer N.\nSecond line: N space-separated integers.",
  "outputFormat": "Print N space-separated integers modulo 1000000007.",
  "constraints": "2 <= N <= 10^5, 0 <= A[i] <= 10^9",
  "sampleCases": [
    {
      "input": "4\n1 2 3 4",
      "expectedOutput": "24 12 8 6",
      "explanation": "Output[0]=2*3*4=24, Output[1]=1*3*4=12, Output[2]=1*2*4=8, Output[3]=1*2*3=6."
    },
    {
      "input": "3\n2 3 5",
      "expectedOutput": "15 10 6",
      "explanation": "Output = [15, 10, 6]."
    }
  ],
  "hiddenCases": [
    {
      "input": "2\n10 20",
      "expectedOutput": "20 10"
    },
    {
      "input": "5\n1 1 1 1 1",
      "expectedOutput": "1 1 1 1 1"
    },
    {
      "input": "4\n0 1 2 3",
      "expectedOutput": "6 0 0 0"
    },
    {
      "input": "4\n0 0 2 3",
      "expectedOutput": "0 0 0 0"
    },
    {
      "input": "5\n2 4 6 8 10",
      "expectedOutput": "1920 960 640 480 384"
    },
    {
      "input": "3\n1000000000 1000000000 1000000000",
      "expectedOutput": "49 49 49"
    },
    {
      "input": "6\n3 2 1 4 5 2",
      "expectedOutput": "80 120 240 60 48 120"
    },
    {
      "input": "4\n5 5 5 5",
      "expectedOutput": "125 125 125 125"
    }
  ]
}