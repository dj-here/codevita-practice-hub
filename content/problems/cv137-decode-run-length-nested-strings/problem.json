{
  "id": "cv137",
  "slug": "cv137-decode-run-length-nested-strings",
  "title": "The Recursive Compression Decompressor",
  "difficulty": "MEDIUM",
  "topics": [
    "Strings & Parsing"
  ],
  "timeLimitMs": 1000,
  "memoryLimitKb": 262144,
  "statement": "Given an encoded string, return its decoded string.\nThe encoding rule is: k[encoded_string], where the encoded_string inside the square brackets is being repeated exactly k times. k is guaranteed to be a positive integer.\nBrackets can be nested.",
  "inputFormat": "A single string S.",
  "outputFormat": "Print the decoded string.",
  "constraints": "1 <= len(S) <= 50\nContains digits, lowercase letters, and square brackets.",
  "sampleCases": [
    {
      "input": "3[a]2[bc]",
      "expectedOutput": "aaabcbc",
      "explanation": "3*a + 2*bc = aaabcbc."
    },
    {
      "input": "3[a2[c]]",
      "expectedOutput": "accaccacc",
      "explanation": "Nested: a2[c] -> acc, 3*acc -> accaccacc."
    }
  ],
  "hiddenCases": [
    {
      "input": "2[abc]3[cd]ef",
      "expectedOutput": "abcabccdcdcdef"
    },
    {
      "input": "abc3[cd]xyz",
      "expectedOutput": "abccdcdcdxyz"
    },
    {
      "input": "1[a]",
      "expectedOutput": "a"
    },
    {
      "input": "2[2[y]pq]",
      "expectedOutput": "yypqyypq"
    },
    {
      "input": "10[a]",
      "expectedOutput": "aaaaaaaaaa"
    },
    {
      "input": "2[b3[a]]",
      "expectedOutput": "baaabaaa"
    },
    {
      "input": "3[z]2[2[y]]",
      "expectedOutput": "zzzyyyy"
    },
    {
      "input": "leetcode",
      "expectedOutput": "leetcode"
    }
  ]
}