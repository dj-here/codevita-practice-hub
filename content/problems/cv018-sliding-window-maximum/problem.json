  "sampleCases": [
    {
      "input": "8 3\n1 3 -1 -3 5 3 6 7",
      "expectedOutput": "3 3 5 5 6 7",
      "explanation": "Windows: [1,3,-1]->3, [3,-1,-3]->3, [-1,-3,5]->5, [-3,5,3]->5, [5,3,6]->6, [3,6,7]->7."
    },
    {
      "input": "1 1\n1",
      "expectedOutput": "1",
      "explanation": "Single element window."
    }
  ],
  "hiddenCases": [
    {
      "input": "5 2\n5 4 3 2 1",
