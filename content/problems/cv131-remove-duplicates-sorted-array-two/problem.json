      "expectedOutput": "2\n1 1"
    },
    {
      "input": "3\n1 1 1",
      "expectedOutput": "2\n1 1"
    },
    {
      "input": "4\n2 2 2 2",
      "expectedOutput": "2\n2 2"
    },
    {
      "input": "5\n1 2 3 4 5",
      "expectedOutput": "5\n1 2 3 4 5"
    },
    {
      "input": "7\n-3 -3 -3 -2 -1 -1 -1",
      "expectedOutput": "5\n-3 -3 -2 -1 -1"
    },
    {
