  "statement": "Given an integer array nums sorted in non-decreasing order, remove some duplicates in-place such that each unique element appears at most twice. The relative order of the elements should be kept the same.\n\nPrint the new length K, followed by the first K elements on the second line.",
  "inputFormat": "First line: Integer N.\nSecond line: N space-separated integers in non-decreasing order.",
  "outputFormat": "First line: Integer K (new length).\nSecond line: K space-separated integers.",
  "constraints": "1 <= N <= 50000\n-10^4 <= nums[i] <= 10^4",
  "sampleCases": [
    {
      "input": "6\n1 1 1 2 2 3",
      "expectedOutput": "5\n1 1 2 2 3",
      "explanation": "New length is 5 with elements [1, 1, 2, 2, 3]."
    },
    {
      "input": "9\n0 0 1 1 1 1 2 3 3",
      "expectedOutput": "7\n0 0 1 1 2 3 3",
      "explanation": "New length 7."
    }
  ],
  "hiddenCases": [
    {
      "input": "1\n1",
      "expectedOutput": "1\n1"
    },
    {
