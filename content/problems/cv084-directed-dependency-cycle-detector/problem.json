{
  "id": "cv084",
  "slug": "cv084-directed-dependency-cycle-detector",
  "title": "The Circular Dependency Investigator",
  "difficulty": "MEDIUM",
  "topics": [
    "Graphs & Trees"
  ],
  "timeLimitMs": 1000,
  "memoryLimitKb": 262144,
  "statement": "A software build system compiles V modules numbered 0 to V - 1 with E compilation dependencies.\nA dependency u -> v means module u requires module v.\n\nDetermine whether there exists any circular dependency chain in the project (i.e., a directed cycle).\nPrint YES if a cycle exists, otherwise print NO.",
  "inputFormat": "First line: Two integers V and E.\nNext E lines: Two integers u and v indicating a directed edge u -> v.",
  "outputFormat": "Print YES or NO.",
  "constraints": "1 <= V <= 5000\n0 <= E <= 10000\n0 <= u, v < V",
  "sampleCases": [
    {
      "input": "3 3\n0 1\n1 2\n2 0",
      "expectedOutput": "YES",
      "explanation": "Cycle: 0 -> 1 -> 2 -> 0."
    },
    {
      "input": "3 2\n0 1\n1 2",
      "expectedOutput": "NO",
      "explanation": "Linear dependency chain, no cycle."
    }
  ],
  "hiddenCases": [
    {
      "input": "1 0",
      "expectedOutput": "NO"
    },
    {
      "input": "2 1\n0 1",
      "expectedOutput": "NO"
    },
    {
      "input": "2 2\n0 1\n1 0",
      "expectedOutput": "YES"
    },
    {
      "input": "4 4\n0 1\n1 2\n2 3\n3 1",
      "expectedOutput": "YES"
    },
    {
      "input": "5 4\n0 1\n0 2\n1 3\n2 4",
      "expectedOutput": "NO"
    },
    {
      "input": "4 4\n0 1\n0 2\n1 3\n2 3",
      "expectedOutput": "NO"
    },
    {
      "input": "5 5\n0 1\n1 2\n2 3\n3 4\n4 2",
      "expectedOutput": "YES"
    },
    {
      "input": "6 5\n0 1\n1 2\n2 3\n3 4\n4 5",
      "expectedOutput": "NO"
    }
  ]
}