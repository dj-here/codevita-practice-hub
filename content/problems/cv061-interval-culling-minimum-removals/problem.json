{
  "id": "cv061",
  "slug": "cv061-interval-culling-minimum-removals",
  "title": "The Astronomical Window Collision",
  "difficulty": "MEDIUM",
  "topics": [
    "Greedy Algorithms"
  ],
  "timeLimitMs": 1000,
  "memoryLimitKb": 262144,
  "statement": "An array of N intervals [Start, End] is observed. Find the minimum number of intervals you need to remove to make the rest of the intervals non-overlapping.\n\nTwo intervals [1, 2] and [2, 3] do NOT overlap (touching at a point is allowed).",
  "inputFormat": "First line: Integer N.\nNext N lines: Two integers Start and End.",
  "outputFormat": "Print the minimum removal count.",
  "constraints": "1 <= N <= 10^5, -10^9 <= Start < End <= 10^9",
  "sampleCases": [
    {
      "input": "4\n1 2\n2 3\n3 4\n1 3",
      "expectedOutput": "1",
      "explanation": "Remove [1, 3] so remaining [1,2], [2,3], [3,4] do not overlap."
    },
    {
      "input": "3\n1 2\n1 2\n1 2",
      "expectedOutput": "2",
      "explanation": "Remove 2 duplicate intervals."
    }
  ],
  "hiddenCases": [
    {
      "input": "1\n1 10",
      "expectedOutput": "0"
    },
    {
      "input": "3\n1 2\n2 3\n3 4",
      "expectedOutput": "0"
    },
    {
      "input": "4\n1 100\n11 22\n1 11\n2 12",
      "expectedOutput": "2"
    },
    {
      "input": "3\n1 10\n2 3\n3 4",
      "expectedOutput": "1"
    },
    {
      "input": "5\n1 4\n2 5\n3 6\n4 7\n5 8",
      "expectedOutput": "3"
    },
    {
      "input": "2\n-10 0\n0 10",
      "expectedOutput": "0"
    },
    {
      "input": "4\n0 2\n1 3\n2 4\n3 5",
      "expectedOutput": "2"
    },
    {
      "input": "3\n1 5\n2 3\n3 4",
      "expectedOutput": "1"
    }
  ]
}