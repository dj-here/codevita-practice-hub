  "statement": "Given matrix A of size N x M and matrix B of size M x K, compute the matrix product C = A * B of size N x K modulo 1000000007.\n\nThe (i, j)-th element of C is defined as:\nC[i][j] = ( sum_{p=0}^{M-1} A[i][p] * B[p][j] ) mod 1000000007.",
  "inputFormat": "First line: Three integers N, M, K.\nNext N lines: M integers per line (Matrix A).\nNext M lines: K integers per line (Matrix B).",
  "outputFormat": "Print N lines with K space-separated integers modulo 1000000007.",
  "constraints": "1 <= N, M, K <= 100, 0 <= A[i][p], B[p][j] <= 10^9",
  "sampleCases": [
    {
      "input": "2 2 2\n1 2\n3 4\n5 6\n7 8",
      "expectedOutput": "19 22\n43 50",
      "explanation": "Standard 2x2 matrix product."
    },
    {
      "input": "1 2 1\n3 4\n5\n6",
      "expectedOutput": "39",
      "explanation": "3*5 + 4*6 = 15 + 24 = 39."
    }
  ],
  "hiddenCases": [
    {
      "input": "1 1 1\n7\n8",
      "expectedOutput": "56"
    },
    {
