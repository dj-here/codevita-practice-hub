{
  "id": "cv039",
  "slug": "cv039-word-search-grid",
  "title": "The Rune Crypt Word Search",
  "difficulty": "MEDIUM",
  "topics": [
    "Matrices & Grids"
  ],
  "timeLimitMs": 1500,
  "memoryLimitKb": 262144,
  "statement": "Given an R x C grid of characters and a string Word, find if the word exists in the grid.\n\nThe word can be constructed from letters of sequentially adjacent cells (horizontally or vertically neighboring). The same letter cell may not be used more than once in forming the word.\n\nPrint \"YES\" if Word exists in the grid, or \"NO\" otherwise.",
  "inputFormat": "First line: Two integers R and C.\nNext R lines: Strings of length C.\nLast line: Target Word string.",
  "outputFormat": "Print \"YES\" or \"NO\".",
  "constraints": "1 <= R, C <= 10, 1 <= |Word| <= 15",
  "sampleCases": [
    {
      "input": "3 4\nABCE\nSFCS\nADEE\nABCCED",
      "expectedOutput": "YES",
      "explanation": "\"ABCCED\" is traceable through the grid."
    },
    {
      "input": "3 4\nABCE\nSFCS\nADEE\nABCB",
      "expectedOutput": "NO",
      "explanation": "Cannot reuse the B cell."
    }
  ],
  "hiddenCases": [
    {
      "input": "1 1\nA\nA",
      "expectedOutput": "YES"
    },
    {
      "input": "1 1\nA\nB",
      "expectedOutput": "NO"
    },
    {
      "input": "2 2\nAB\nCD\nACDB",
      "expectedOutput": "YES"
    },
    {
      "input": "3 3\nCAT\nOGD\nXYZ\nCATDOG",
      "expectedOutput": "NO"
    },
    {
      "input": "2 3\nAAA\nAAA\nAAAAAA",
      "expectedOutput": "YES"
    },
    {
      "input": "3 3\nABC\nDEF\nGHI\nABCFEDGHI",
      "expectedOutput": "YES"
    },
    {
      "input": "2 2\nAB\nCD\nABCD",
      "expectedOutput": "NO"
    },
    {
      "input": "4 4\nTEST\nESTE\nSTES\nTEST\nSET",
      "expectedOutput": "YES"
    }
  ]
}