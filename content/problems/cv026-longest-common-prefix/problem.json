{
  "id": "cv026",
  "slug": "cv026-longest-common-prefix",
  "title": "The Royal Archive Common Prefix",
  "difficulty": "EASY",
  "topics": [
    "Strings & Parsing"
  ],
  "timeLimitMs": 1000,
  "memoryLimitKb": 262144,
  "statement": "An archivist examines N scrolls containing royal titles. To classify the scrolls into cabinets, the archivist finds the longest common prefix shared by all titles.\n\nGiven N strings, print their longest common prefix. If there is no common prefix, print \"-1\".",
  "inputFormat": "First line: Integer N.\nNext N lines: One string per line.",
  "outputFormat": "Print the longest common prefix, or -1 if empty.",
  "constraints": "1 <= N <= 1000, 1 <= length of each string <= 1000",
  "sampleCases": [
    {
      "input": "3\nflower\nflow\nflight",
      "expectedOutput": "fl",
      "explanation": "Common prefix across all three strings is \"fl\"."
    },
    {
      "input": "3\ndog\nracecar\ncar",
      "expectedOutput": "-1",
      "explanation": "No common prefix."
    }
  ],
  "hiddenCases": [
    {
      "input": "1\nalone",
      "expectedOutput": "alone"
    },
    {
      "input": "2\napple\napp",
      "expectedOutput": "app"
    },
    {
      "input": "4\ninterview\nintermediate\ninternal\ninternational",
      "expectedOutput": "inter"
    },
    {
      "input": "3\ncodevita\ncodechef\ncodeforces",
      "expectedOutput": "code"
    },
    {
      "input": "3\na\nb\nc",
      "expectedOutput": "-1"
    },
    {
      "input": "2\nsame\nsame",
      "expectedOutput": "same"
    },
    {
      "input": "4\nprefix\npre\npreview\npreparation",
      "expectedOutput": "pre"
    },
    {
      "input": "3\nz\nzz\nzzz",
      "expectedOutput": "z"
    }
  ]
}