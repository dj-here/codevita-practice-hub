{
  "id": "cv019",
  "slug": "cv019-triplet-zero-sum",
  "title": "The Alchemical Zero-Sum Triplet",
  "difficulty": "EASY",
  "topics": [
    "Arrays & Two Pointers"
  ],
  "timeLimitMs": 1500,
  "memoryLimitKb": 262144,
  "statement": "Given an integer array A of size N, find the count of unique triplets [A[i], A[j], A[k]] with i < j < k such that A[i] + A[j] + A[k] = 0.\n\nNote: Unique triplets mean triplets with distinct values (e.g. [-1, 0, 1] is only counted once even if it can be formed by different index combinations).",
  "inputFormat": "First line: Integer N.\nSecond line: N space-separated integers.",
  "outputFormat": "Print the count of unique triplets whose sum is 0.",
  "constraints": "3 <= N <= 3000, -10^5 <= A[i] <= 10^5",
  "sampleCases": [
    {
      "input": "6\n-1 0 1 2 -1 -4",
      "expectedOutput": "2",
      "explanation": "Unique triplets: [-1, -1, 2] and [-1, 0, 1]."
    },
    {
      "input": "3\n0 1 1",
      "expectedOutput": "0",
      "explanation": "No triplet sums to 0."
    }
  ],
  "hiddenCases": [
    {
      "input": "3\n0 0 0",
      "expectedOutput": "1"
    },
    {
      "input": "7\n-2 0 1 1 2 -1 -4",
      "expectedOutput": "3"
    },
    {
      "input": "5\n1 2 3 4 5",
      "expectedOutput": "0"
    },
    {
      "input": "5\n-5 -4 -3 -2 -1",
      "expectedOutput": "0"
    },
    {
      "input": "8\n-4 -2 -2 -2 0 1 2 2",
      "expectedOutput": "2"
    },
    {
      "input": "6\n-3 1 2 0 -1 3",
      "expectedOutput": "3"
    },
    {
      "input": "9\n-6 -4 -2 0 2 4 6 8 10",
      "expectedOutput": "7"
    },
    {
      "input": "4\n0 0 0 0",
      "expectedOutput": "1"
    }
  ]
}