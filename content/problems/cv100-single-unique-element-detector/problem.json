  "outputFormat": "Print the unique solitary integer.",
  "constraints": "1 <= N <= 100001\n-10^9 <= A_i <= 10^9",
  "sampleCases": [
    {
      "input": "5\n4 1 2 1 2",
      "expectedOutput": "4",
      "explanation": "1 and 2 appear twice; 4 appears once."
    },
    {
      "input": "3\n2 2 1",
      "expectedOutput": "1",
      "explanation": "2 appears twice; 1 appears once."
    }
  ],
  "hiddenCases": [
