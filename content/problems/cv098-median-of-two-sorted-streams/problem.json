{
  "id": "cv098",
  "slug": "cv098-median-of-two-sorted-streams",
  "title": "The Dual Celestial Stream Median",
  "difficulty": "HARD",
  "topics": [
    "Binary Search & Sorting"
  ],
  "timeLimitMs": 1500,
  "memoryLimitKb": 262144,
  "statement": "Two radio telescopes record frequency signals into two sorted arrays A of size N and B of size M.\nFind the median of the two combined sorted arrays.\n\nThe overall run time complexity should be O(log(min(N, M))).\nPrint the median formatted to exactly 1 decimal place.",
  "inputFormat": "First line: Two integers N and M.\nSecond line: N space-separated integers (array A).\nThird line: M space-separated integers (array B).",
  "outputFormat": "Print the median formatted to 1 decimal place (e.g. 2.0 or 2.5).",
  "constraints": "0 <= N, M <= 50000\n1 <= N + M <= 100000\n-10^9 <= A_i, B_j <= 10^9",
  "sampleCases": [
    {
      "input": "2 1\n1 3\n2",
      "expectedOutput": "2.0",
      "explanation": "Merged array: [1, 2, 3], median is 2.0."
    },
    {
      "input": "2 2\n1 2\n3 4",
      "expectedOutput": "2.5",
      "explanation": "Merged array: [1, 2, 3, 4], median is (2 + 3) / 2 = 2.5."
    }
  ],
  "hiddenCases": [
    {
      "input": "1 0\n42\n",
      "expectedOutput": "42.0"
    },
    {
      "input": "0 2\n\n1 3",
      "expectedOutput": "2.0"
    },
    {
      "input": "4 4\n1 3 5 7\n2 4 6 8",
      "expectedOutput": "4.5"
    },
    {
      "input": "5 3\n1 2 3 4 5\n6 7 8",
      "expectedOutput": "4.5"
    },
    {
      "input": "3 5\n10 20 30\n5 15 25 35 45",
      "expectedOutput": "22.5"
    },
    {
      "input": "1 1\n10\n10",
      "expectedOutput": "10.0"
    },
    {
      "input": "4 2\n2 3 5 8\n10 12",
      "expectedOutput": "6.5"
    },
    {
      "input": "3 3\n-5 3 6\n-2 0 2",
      "expectedOutput": "1.0"
    }
  ]
}