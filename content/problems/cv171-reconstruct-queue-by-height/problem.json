  "statement": "You are given an array of people, people, which are the attributes of some people in a queue (not necessarily in order). Each people[i] = [h_i, k_i] represents the i-th person of height h_i with exactly k_i other people in front who have a height greater than or equal to h_i.\n\nReconstruct and print the queue that is represented by the input.\nPrint each person as \"h k\" on a new line.",
  "inputFormat": "First line: Integer N.\nNext N lines: Two integers h and k.",
  "outputFormat": "Print the reconstructed queue line by line.",
  "constraints": "1 <= N <= 2000\n0 <= h <= 10^6\n0 <= k < N",
  "sampleCases": [
    {
      "input": "6\n7 0\n4 4\n7 1\n5 0\n6 1\n5 2",
      "expectedOutput": "5 0\n7 0\n5 2\n6 1\n4 4\n7 1",
      "explanation": "Standard reconstructed order."
    },
    {
      "input": "2\n6 0\n5 0",
      "expectedOutput": "5 0\n6 0",
      "explanation": "Shorter person inserted at index 0."
    }
  ],
  "hiddenCases": [
    {
      "input": "1\n100 0",
      "expectedOutput": "100 0"
    },
    {
      "input": "3\n1 0\n2 0\n3 0",
      "expectedOutput": "1 0\n2 0\n3 0"
    },
    {
      "input": "3\n3 0\n2 1\n1 2",
      "expectedOutput": "3 0\n2 1\n1 2"
    },
    {
      "input": "5\n10 0\n10 1\n10 2\n10 3\n10 4",
      "expectedOutput": "10 0\n10 1\n10 2\n10 3\n10 4"
    },
    {
      "input": "4\n2 0\n1 1\n4 0\n3 1",
      "expectedOutput": "2 0\n1 1\n4 0\n3 1"
    },
    {
      "input": "6\n9 0\n7 0\n1 0\n5 0\n3 0\n2 0",
      "expectedOutput": "1 0\n2 0\n3 0\n5 0\n7 0\n9 0"
    },
    {
      "input": "5\n6 0\n5 0\n4 0\n3 2\n2 2",
      "expectedOutput": "4 0\n5 0\n2 2\n3 2\n6 0"
    },
    {
      "input": "4\n5 0\n5 1\n4 2\n6 0",
      "expectedOutput": "5 0\n5 1\n4 2\n6 0"
    }
  ]
