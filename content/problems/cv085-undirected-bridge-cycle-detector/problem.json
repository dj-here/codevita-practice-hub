  "title": "The Stone Bridge Loop Detector",
  "difficulty": "MEDIUM",
  "topics": [
    "Graphs & Trees"
  ],
  "timeLimitMs": 1000,
  "memoryLimitKb": 262144,
  "statement": "An architectural engineer surveys V stone pillars numbered 0 to V - 1 connected by E bidirectional bridge spans.\n\nDetermine whether the structure contains any closed topological loop (undirected cycle).\nPrint YES if at least one loop exists, otherwise print NO.",
  "inputFormat": "First line: Two integers V and E.\nNext E lines: Two integers u and v indicating an undirected bridge between u and v.",
  "outputFormat": "Print YES or NO.",
  "constraints": "1 <= V <= 5000\n0 <= E <= 10000\n0 <= u, v < V",
  "sampleCases": [
    {
      "input": "3 3\n0 1\n1 2\n2 0",
      "expectedOutput": "YES",
      "explanation": "Triangle loop formed by pillars 0, 1, 2."
    },
    {
      "input": "3 2\n0 1\n1 2",
      "expectedOutput": "NO",
      "explanation": "Simple tree line, no loops."
    }
  ],
  "hiddenCases": [
    {
      "input": "1 0",
      "expectedOutput": "NO"
    },
    {
      "input": "2 1\n0 1",
      "expectedOutput": "NO"
    },
    {
      "input": "4 4\n0 1\n1 2\n2 3\n3 0",
      "expectedOutput": "YES"
    },
    {
      "input": "5 4\n0 1\n1 2\n2 3\n3 4",
      "expectedOutput": "NO"
    },
    {
      "input": "4 3\n0 1\n0 2\n0 3",
      "expectedOutput": "NO"
    },
    {
      "input": "5 5\n0 1\n1 2\n2 0\n3 4\n4 3",
      "expectedOutput": "YES"
    },
    {
      "input": "6 5\n0 1\n1 2\n3 4\n4 5\n5 3",
      "expectedOutput": "YES"
    },
    {
      "input": "6 4\n0 1\n1 2\n3 4\n4 5",
      "expectedOutput": "NO"
    }
  ]
}