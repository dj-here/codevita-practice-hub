  "sampleCases": [
    {
      "input": "3\n1 2 3\n4 5 6\n7 8 9",
      "expectedOutput": "7 4 1\n8 5 2\n9 6 3",
      "explanation": "Matrix rotated 90 degrees clockwise."
    },
    {
      "input": "2\n1 2\n3 4",
      "expectedOutput": "3 1\n4 2",
      "explanation": "2x2 rotation."
    }
  ],
  "hiddenCases": [
    {
      "input": "1\n100",
      "expectedOutput": "100"
