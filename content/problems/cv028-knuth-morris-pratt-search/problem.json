  "statement": "A transmission station sends a long signal Text and searches for all 1-based start indices where a pattern Pattern appears as a contiguous substring.\n\nGiven Text and Pattern, print all 1-based starting positions of Pattern in Text separated by spaces. If Pattern does not appear, print -1.",
  "inputFormat": "First line: String Text.\nSecond line: String Pattern.",
  "outputFormat": "Print 1-based starting indices separated by spaces, or -1.",
  "constraints": "1 <= |Pattern| <= |Text| <= 10^5, English letters.",
  "sampleCases": [
    {
      "input": "AABAACAADAABAABA\nAABA",
      "expectedOutput": "1 10 13",
      "explanation": "Pattern \"AABA\" occurs at indices 1, 9, 13 (1-based)."
    },
    {
      "input": "HELLO\nWORLD",
      "expectedOutput": "-1",
      "explanation": "Not found."
    }
  ],
  "hiddenCases": [
    {
      "input": "AAAAA\nAA",
      "expectedOutput": "1 2 3 4"
    },
    {
      "input": "ABCDEF\nCD",
      "expectedOutput": "3"
    },
    {
      "input": "BATMANANDROBIN\nBAT",
      "expectedOutput": "1"
    },
    {
      "input": "XYZ\nXYZ",
      "expectedOutput": "1"
    },
    {
      "input": "CODEVITACODEVITACODE\nCODEVITA",
      "expectedOutput": "1 9"
    },
    {
      "input": "ABABABABAB\nABA",
      "expectedOutput": "1 3 5 7"
    },
    {
      "input": "MISSISSIPPI\nIS",
      "expectedOutput": "2 5"
    },
    {
      "input": "TESTSTRING\nNOTFOUND",
      "expectedOutput": "-1"
    }
  ]
