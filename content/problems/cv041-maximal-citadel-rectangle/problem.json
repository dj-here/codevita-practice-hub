  "outputFormat": "Print the maximum rectangular area of 1s.",
  "constraints": "1 <= R, C <= 200",
  "sampleCases": [
    {
      "input": "4 5\n10100\n10111\n11111\n10010",
      "expectedOutput": "6",
      "explanation": "A 2x3 rectangle of 1s exists in rows 2 and 3, columns 2-4."
    },
    {
      "input": "1 1\n0",
      "expectedOutput": "0",
      "explanation": "No 1s."
    },
    {
      "input": "1 1\n1",
      "expectedOutput": "1",
      "explanation": "1x1 rectangle."
    }
  ],
  "hiddenCases": [
