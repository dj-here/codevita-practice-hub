# Database (SQLite for zero-config dev / PostgreSQL for production)
DATABASE_URL="file:./dev.db"
# For production PostgreSQL:
# DATABASE_URL="postgresql://user:password@localhost:5432/pujaconnect?schema=public"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# JWT Secret for Session Cookies (Generate a 64+ char random string in production)
JWT_SECRET="change-this-to-a-secure-random-secret-key-min-32-chars"

# Razorpay Payment Gateway (Optional in development - Sandbox Simulator is enabled by default)
RAZORPAY_KEY_ID="rzp_test_placeholder"
RAZORPAY_KEY_SECRET="rzp_secret_placeholder"
RAZORPAY_WEBHOOK_SECRET="rzp_webhook_secret_placeholder"

# Payment Sandbox Simulator (Set to "true" for local testing without real payment cards)
ENABLE_SANDBOX_PAYMENTS="true"

# Google Gemini AI Integration (Optional: deterministic rule-based NLP fallback works offline)
GEMINI_API_KEY=""

# Platform Settings
DEFAULT_CITY="Hyderabad"
PLATFORM_COMMISSION_PERCENT="15"
