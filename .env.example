# ==============================================================================
# CODEVITA PRACTICE HUB - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Database Connection (PostgreSQL for Docker/Production, SQLite file:./dev.db for local dev)
# Docker / Production: postgresql://postgres:postgres@localhost:5432/codevita_hub?schema=public
# Local zero-dependency dev: file:./dev.db
DATABASE_URL="file:./dev.db"

# NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="codevita-hub-secure-random-secret-key-at-least-32-chars-long"

# Google OAuth (Optional: Leave empty for email/password credentials only)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Judge0 CE Sandbox Configuration
# When running with Docker Compose: http://localhost:2358
JUDGE0_API_URL="http://localhost:2358"
JUDGE0_API_KEY=""

# Anthropic Claude API Key for Mock Interviews (Optional)
# If left blank, mock interviews automatically use the curated static question bank with scoring rubrics
ANTHROPIC_API_KEY=""

# Default Initial Administrator Credentials (used by npm run seed)
ADMIN_NAME="System Administrator"
ADMIN_EMAIL="admin@codevita.hub"
ADMIN_PASSWORD="Admin@CodeVita2026"

# Default Demo Student Credentials (used by npm run seed)
STUDENT_NAME="Demo Student"
STUDENT_EMAIL="student@codevita.hub"
STUDENT_PASSWORD="Student@2026"

# Contest and Portal URLs
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_CODEVITA_PORTAL_URL="https://codevita.tcsapps.com"
